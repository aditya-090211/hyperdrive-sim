{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "scout.overdrive009.in"
        }
      ],
      "destination": "/scout",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.overdrive009.in"
        }
      ],
      "destination": "https://overdrive009.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "viora.overdrive009.in"
        }
      ],
      "destination": "https://overdrive009.in/viora/:path*",
      "permanent": false
    },
    {
      "source": "/scout",
      "has": [
        {
          "type": "host",
          "value": "overdrive009.in"
        }
      ],
      "destination": "https://scout.overdrive009.in/scout",
      "permanent": true
    },
    {
      "source": "/((?!scout|signin|js/|css/|lib/|assets/|sw\\.js|manifest).*)",
      "has": [
        {
          "type": "host",
          "value": "hyperdrive-sim.vercel.app"
        }
      ],
      "destination": "https://overdrive009.in/$1",
      "permanent": true
    },
    {
      "source": "/viora",
      "destination": "/viora/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/team/:code/reading",
      "destination": "https://viora-lemon.vercel.app/api/team/:code/reading"
    },
    {
      "source": "/api/team/:code",
      "destination": "https://viora-lemon.vercel.app/api/team/:code"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js 'unsafe-eval' 'wasm-unsafe-eval' 'sha256-6EmSodU9BvfICRJEqHXfU1TesgxTJv+7C8vSBnA5sLY='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cteojtbdtydarwxdrjvp.supabase.co wss://cteojtbdtydarwxdrjvp.supabase.co https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/((?!viora).*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), gamepad=(self)"
        }
      ]
    },
    {
      "source": "/viora(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), gamepad=()"
        }
      ]
    },
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/punk/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/viora/(js|css|i18n)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/viora/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}